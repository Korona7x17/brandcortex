# --- BrandCortex API ---
BRANDCORTEX_ENV=local
BRANDCORTEX_LOG_LEVEL=INFO

# BrandCortex's own database (posts, features, insights, playbook, tokens, config)
DATABASE_URL=postgresql+psycopg://brandcortex:brandcortex@localhost:5432/brandcortex

# Brand DB — READ-ONLY seam. BrandCortex polls `card_renders` and never writes here.
# Use a role with SELECT on card_renders (and swimmers, for the Phase 2 opportunity scanner) so the
# read-only contract is enforced by Postgres rather than by discipline.
# See open decision #2: same server or separate; logical separation holds either way.
BRAND_DB_URL=postgresql+psycopg://readonly:readonly@localhost:5432/thaiswim

# Brand site. Card render URLs and canonical links are derived from this — point it at staging to
# draft safely without linking to production.
BRAND_SITE_URL=https://thaiswim.com

# BrandCortex's OWN store for captured card PNGs. Not shared with the brand — the brand never writes
# here. Each card is fetched once at draft time and those exact bytes are what publish.
#
# A path (or a file:// URL) means local disk and none of the credentials below are read — that is the
# local-development setting. Anything else is treated as an S3-compatible bucket name.
ASSET_BUCKET=brandcortex-assets
ASSET_ENDPOINT_URL=
ASSET_ACCESS_KEY_ID=
ASSET_SECRET_ACCESS_KEY=
ASSET_REGION=ap-southeast-1

# Fernet key encrypting rows in `channel_tokens`. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Generation engine (LLM) ---
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5

# --- Facebook channel adapter ---
# App Review + business verification required before production publishing.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_PAGE_ID=

# BOOTSTRAP ONLY — the first Page token, before the DB exists to hold it.
# On first run it is encrypted into `channel_tokens` and this line should then be blanked.
# Not the long-term home: tokens live encrypted at rest, never in a dotfile.
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Site analytics (north star: real sessions, not FB's click number) ---
ANALYTICS_PROVIDER=plausible
ANALYTICS_API_KEY=
ANALYTICS_SITE_ID=thaiswim.com

# --- Web dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Auth ---------------------------------------------------------------------------------------
# Fail closed: with neither variable set, every API route except /health returns 503.
# CLERK_ISSUER is the Clerk instance's frontend API origin — the `iss` claim in its session tokens
# (e.g. https://clerk.brandcortex.app, or https://xxx.clerk.accounts.dev while in development).
CLERK_ISSUER=
# Origins allowed to have minted the session (the token's `azp`). Comma-separated.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Explicit local-development opt-out. Never set this anywhere deployed.
AUTH_DISABLED=false

# --- Dashboard (apps/web; Clerk turns on when the publishable key is present) --------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
